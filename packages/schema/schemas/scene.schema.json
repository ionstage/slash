{
  "$id": "slash/scene",
  "title": "Slash scene (scenes/*.json)",
  "description": "One scene: a stage, actors placed on it, a camera viewpoint, lights and effects, all driven by the scene's progress axis t in [0,1]. Scenes are passive — scrolling is the only input.",
  "type": "object",
  "required": ["formatVersion", "id", "stage", "camera"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "description": "Display name shown in the editor." },
    "scrollLength": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 20,
      "description": "How much scrolling this scene spans, in viewport heights. Controls pacing; default 3."
    },
    "stage": {
      "type": "object",
      "required": ["assetId"],
      "additionalProperties": false,
      "description": "The environment the scene plays in.",
      "properties": {
        "assetId": {
          "type": "string",
          "description": "Asset id from assets/index.json (type: stage)."
        },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "actors": {
      "type": "array",
      "description": "Characters and props placed in the scene.",
      "items": {
        "type": "object",
        "required": ["id", "assetId"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Scene-local actor id, referenced by tracks."
          },
          "assetId": { "type": "string" },
          "transform": { "$ref": "#/$defs/transform" },
          "idleClip": {
            "type": "string",
            "description": "Name of a glTF animation clip to loop while the actor is idle."
          },
          "tracks": {
            "type": "object",
            "additionalProperties": false,
            "description": "Progress-driven animation of the actor's transform.",
            "properties": {
              "position": { "$ref": "#/$defs/vec3Track" },
              "rotation": { "$ref": "#/$defs/vec3Track" },
              "scale": { "$ref": "#/$defs/vec3Track" }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewpoint"],
      "description": "The section's intended camera viewpoint — framed once, like a comic panel, and held for the whole section. Each section only needs to look right from this viewpoint. Optional `drift` adds restrained movement over progress t.",
      "properties": {
        "viewpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "target"],
          "description": "The fixed shot: where the camera sits and the point it looks at.",
          "properties": {
            "position": { "$ref": "#/$defs/vec3", "description": "Camera position in meters." },
            "target": {
              "$ref": "#/$defs/vec3",
              "description": "Point the camera looks at, in meters."
            },
            "fov": {
              "type": "number",
              "minimum": 10,
              "maximum": 120,
              "description": "Vertical FOV in degrees. Default 50."
            }
          }
        },
        "drift": {
          "type": "object",
          "additionalProperties": false,
          "description": "Restrained in-section movement: offsets added to the viewpoint over progress t in [0,1]. Keep it subtle — the viewpoint is the shot.",
          "properties": {
            "position": {
              "$ref": "#/$defs/vec3Track",
              "description": "Position offset (meters) added to the viewpoint over t."
            },
            "target": {
              "$ref": "#/$defs/vec3Track",
              "description": "Look-at offset (meters) added to the viewpoint over t."
            },
            "fov": {
              "$ref": "#/$defs/numberTrack",
              "description": "FOV offset (degrees) added over t."
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scene atmosphere overrides.",
      "properties": {
        "fog": {
          "type": "object",
          "required": ["color", "near", "far"],
          "additionalProperties": false,
          "description": "Linear fog for this scene (overrides the project default).",
          "properties": {
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "near": { "type": "number", "minimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "post": {
      "type": "boolean",
      "description": "Set false to disable the project's post-processing chain in this scene."
    },
    "lights": {
      "type": "array",
      "description": "Scene lighting. When present, replaces the runtime's default lights. Tracks animate over scene progress (time-of-day transitions).",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "enum": ["ambient", "directional", "point"] },
          "color": {
            "$ref": "#/$defs/vec3",
            "description": "RGB in [0,1] (array form so it can be keyframed)."
          },
          "intensity": { "type": "number", "minimum": 0 },
          "position": { "$ref": "#/$defs/vec3" },
          "target": { "$ref": "#/$defs/vec3", "description": "Aim point (directional lights)." },
          "distance": {
            "type": "number",
            "minimum": 0,
            "description": "Point light falloff distance (0 = infinite)."
          },
          "tracks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intensity": { "$ref": "#/$defs/numberTrack" },
              "color": { "$ref": "#/$defs/vec3Track" },
              "position": { "$ref": "#/$defs/vec3Track" }
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "description": "Ambient particle effects, driven by presets and animated over scene progress.",
      "items": {
        "type": "object",
        "required": ["id", "preset"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "preset": { "enum": ["rain", "snow", "sparks", "fireflies"] },
          "enabled": {
            "type": "boolean",
            "description": "Whether the effect renders; default true."
          },
          "count": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "area": {
            "$ref": "#/$defs/vec3",
            "description": "Emission box size in meters. Default [20,10,20]."
          },
          "position": { "$ref": "#/$defs/vec3", "description": "Center of the emission box." },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Particle size in world units."
          },
          "tracks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intensity": {
                "$ref": "#/$defs/numberTrack",
                "description": "0..1 opacity/emission multiplier over scene progress."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "description": "Position in meters, rotation as XYZ euler degrees, uniform or per-axis scale.",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/vec3" },
        "scale": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "$ref": "#/$defs/vec3" }]
        }
      }
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "easing": {
      "enum": ["linear", "easeIn", "easeOut", "easeInOut", "step"],
      "description": "Interpolation from the previous keyframe to this one. Default linear."
    },
    "vec3Track": {
      "type": "array",
      "minItems": 1,
      "description": "Keyframes over scene progress t in [0,1], sorted by t.",
      "items": {
        "type": "object",
        "required": ["t", "value"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": { "$ref": "#/$defs/vec3" },
          "easing": { "$ref": "#/$defs/easing" }
        }
      }
    },
    "numberTrack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "value"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": { "type": "number" },
          "easing": { "$ref": "#/$defs/easing" }
        }
      }
    }
  }
}
