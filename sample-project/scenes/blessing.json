{
  "formatVersion": 1,
  "id": "blessing",
  "name": "The Blessing",
  "scrollLength": 3,
  "stage": {
    "assetId": "shrine-stage"
  },
  "actors": [
    {
      "id": "traveler",
      "assetId": "traveler",
      "transform": { "position": [0, 0, 2], "rotation": [0, 180, 0] }
    },
    {
      "id": "spirit",
      "assetId": "spirit",
      "transform": { "position": [0, 1.2, -1] },
      "tracks": {
        "position": [
          { "t": 0, "value": [0, 1.2, -1] },
          { "t": 1, "value": [0, 3.2, -1], "easing": "easeInOut" }
        ]
      }
    }
  ],
  "camera": {
    "fov": 45,
    "tracks": {
      "position": [
        { "t": 0, "value": [0, 1.6, 6] },
        { "t": 1, "value": [1.5, 3, 2.5], "easing": "easeInOut" }
      ],
      "lookAt": [
        { "t": 0, "value": [0, 1.5, 0] },
        { "t": 1, "value": [0, 2.8, -1], "easing": "easeInOut" }
      ]
    }
  },
  "events": [
    {
      "id": "blessed",
      "trigger": { "type": "progress", "at": 0.2 },
      "actions": [{ "type": "log", "message": "A gentle light blesses the traveler." }]
    },
    {
      "id": "return-to-meadow",
      "trigger": { "type": "tap", "target": "spirit" },
      "once": false,
      "actions": [
        { "type": "log", "message": "The spirit carries the traveler back to the meadow." },
        { "type": "gotoScene", "scene": "meadow" }
      ]
    }
  ]
}
