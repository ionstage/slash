{
  "formatVersion": 2,
  "id": "blessing",
  "name": "The Blessing",
  "scrollLength": 3,
  "stage": {
    "assetId": "shrine-stage"
  },
  "environment": {
    "fog": { "color": "#141824", "near": 5, "far": 32 }
  },
  "lights": [
    { "id": "night", "type": "ambient", "color": [0.4, 0.45, 0.65], "intensity": 0.9 },
    {
      "id": "spirit-glow",
      "type": "point",
      "color": [0.62, 0.85, 1],
      "intensity": 8,
      "distance": 10,
      "position": [0, 1.4, -1],
      "tracks": {
        "position": [
          { "t": 0, "value": [0, 1.4, -1] },
          { "t": 1, "value": [0, 3.4, -1], "easing": "easeInOut" }
        ]
      }
    }
  ],
  "effects": [
    {
      "id": "blessing-sparks",
      "preset": "sparks",
      "count": 220,
      "color": "#ffd77a",
      "area": [4, 5, 4],
      "position": [0, 2.5, -1],
      "enabled": false
    }
  ],
  "actors": [
    {
      "id": "traveler",
      "assetId": "traveler",
      "transform": { "position": [0, 0, 2], "rotation": [0, 180, 0] }
    },
    {
      "id": "spirit",
      "assetId": "spirit",
      "transform": { "position": [0, 1.2, -1] },
      "tracks": {
        "position": [
          { "t": 0, "value": [0, 1.2, -1] },
          { "t": 1, "value": [0, 3.2, -1], "easing": "easeInOut" }
        ]
      }
    }
  ],
  "camera": {
    "viewpoint": {
      "position": [0, 2, 6],
      "target": [0, 2.2, -1],
      "fov": 45
    },
    "drift": {
      "target": [
        { "t": 0, "value": [0, 0, 0] },
        { "t": 1, "value": [0, 1, 0], "easing": "easeInOut" }
      ]
    }
  },
  "events": [
    {
      "id": "blessed",
      "trigger": { "type": "progress", "at": 0.2 },
      "actions": [
        { "type": "log", "message": "A gentle light blesses the traveler." },
        { "type": "setEffect", "target": "blessing-sparks", "enabled": true }
      ]
    },
    {
      "id": "return-to-meadow",
      "trigger": { "type": "tap", "target": "spirit" },
      "once": false,
      "actions": [
        { "type": "log", "message": "The spirit carries the traveler back to the meadow." },
        { "type": "gotoScene", "scene": "meadow" }
      ]
    }
  ]
}
