{
  "$id": "slash/state",
  "title": "Slash state definition (state.json)",
  "description": "Declares the story's persistent state: flags, counters and items, with initial values. Events read and write these; scene content can depend on them.",
  "type": "object",
  "required": ["formatVersion"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "description": "Boolean story flags, keyed by name.",
      "patternProperties": {
        "^[a-z][a-zA-Z0-9_-]*$": {
          "type": "object",
          "required": ["initial"],
          "additionalProperties": false,
          "properties": {
            "initial": { "type": "boolean" },
            "description": { "type": "string" }
          }
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "description": "Numeric story counters, keyed by name.",
      "patternProperties": {
        "^[a-z][a-zA-Z0-9_-]*$": {
          "type": "object",
          "required": ["initial"],
          "additionalProperties": false,
          "properties": {
            "initial": { "type": "number" },
            "description": { "type": "string" }
          }
        }
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "description": "Collectible items, keyed by name. Runtime tracks owned/not owned.",
      "patternProperties": {
        "^[a-z][a-zA-Z0-9_-]*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" }
          }
        }
      }
    }
  }
}
