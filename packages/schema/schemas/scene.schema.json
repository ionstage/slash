{
  "$id": "slash/scene",
  "title": "Slash scene (scenes/*.json)",
  "description": "One scene: a stage, actors placed on it, camera direction, animation tracks and events, all driven by the scene's progress axis t in [0,1].",
  "type": "object",
  "required": ["formatVersion", "id", "stage", "camera"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "description": "Display name shown in the editor." },
    "scrollLength": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 20,
      "description": "How much scrolling this scene spans, in viewport heights. Controls pacing; default 3."
    },
    "stage": {
      "type": "object",
      "required": ["assetId"],
      "additionalProperties": false,
      "description": "The environment the scene plays in.",
      "properties": {
        "assetId": { "type": "string", "description": "Asset id from assets/index.json (type: stage)." },
        "transform": { "$ref": "#/$defs/transform" }
      }
    },
    "actors": {
      "type": "array",
      "description": "Characters and props placed in the scene.",
      "items": {
        "type": "object",
        "required": ["id", "assetId"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Scene-local actor id, referenced by tracks and events."
          },
          "assetId": { "type": "string" },
          "transform": { "$ref": "#/$defs/transform" },
          "idleClip": {
            "type": "string",
            "description": "Name of a glTF animation clip to loop while the actor is idle."
          },
          "visibleWhen": {
            "$ref": "#/$defs/condition",
            "description": "Hidden element: the actor is only visible while this state condition holds (re-evaluated live)."
          },
          "tracks": {
            "type": "object",
            "additionalProperties": false,
            "description": "Progress-driven animation of the actor's transform.",
            "properties": {
              "position": { "$ref": "#/$defs/vec3Track" },
              "rotation": { "$ref": "#/$defs/vec3Track" },
              "scale": { "$ref": "#/$defs/vec3Track" }
            }
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracks"],
      "description": "Camera direction over the progress axis.",
      "properties": {
        "fov": { "type": "number", "minimum": 10, "maximum": 120, "description": "Base vertical FOV in degrees. Default 50." },
        "tracks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "lookAt"],
          "properties": {
            "position": { "$ref": "#/$defs/vec3Track" },
            "lookAt": { "$ref": "#/$defs/vec3Track" },
            "fov": { "$ref": "#/$defs/numberTrack" }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scene soundtrack. Both crossfade on scene changes.",
      "properties": {
        "bgm": { "type": "string", "description": "Audio asset id, looped as background music." },
        "ambient": { "type": "string", "description": "Audio asset id, looped as environment sound." }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scene atmosphere overrides.",
      "properties": {
        "fog": {
          "type": "object",
          "required": ["color", "near", "far"],
          "additionalProperties": false,
          "description": "Linear fog for this scene (overrides the project default).",
          "properties": {
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "near": { "type": "number", "minimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "post": {
      "type": "boolean",
      "description": "Set false to disable the project's post-processing chain in this scene."
    },
    "lights": {
      "type": "array",
      "description": "Scene lighting. When present, replaces the runtime's default lights. Tracks animate over scene progress (time-of-day transitions).",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "enum": ["ambient", "directional", "point"] },
          "color": {
            "$ref": "#/$defs/vec3",
            "description": "RGB in [0,1] (array form so it can be keyframed)."
          },
          "intensity": { "type": "number", "minimum": 0 },
          "position": { "$ref": "#/$defs/vec3" },
          "target": { "$ref": "#/$defs/vec3", "description": "Aim point (directional lights)." },
          "distance": { "type": "number", "minimum": 0, "description": "Point light falloff distance (0 = infinite)." },
          "tracks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intensity": { "$ref": "#/$defs/numberTrack" },
              "color": { "$ref": "#/$defs/vec3Track" },
              "position": { "$ref": "#/$defs/vec3Track" }
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "description": "Ambient particle effects, driven by presets and toggled by events (setEffect).",
      "items": {
        "type": "object",
        "required": ["id", "preset"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "preset": { "enum": ["rain", "snow", "sparks", "fireflies"] },
          "enabled": { "type": "boolean", "description": "Initial state; default true." },
          "count": { "type": "integer", "minimum": 1, "maximum": 5000 },
          "area": { "$ref": "#/$defs/vec3", "description": "Emission box size in meters. Default [20,10,20]." },
          "position": { "$ref": "#/$defs/vec3", "description": "Center of the emission box." },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "size": { "type": "number", "exclusiveMinimum": 0, "description": "Particle size in world units." },
          "tracks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intensity": {
                "$ref": "#/$defs/numberTrack",
                "description": "0..1 opacity/emission multiplier over scene progress."
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Data-driven events: a trigger fires its actions.",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "actions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "once": {
            "type": "boolean",
            "description": "If true (default), the event fires only the first time its trigger matches."
          },
          "when": {
            "$ref": "#/$defs/condition",
            "description": "Extra gate: the trigger only fires while this state condition holds (checked without consuming `once`)."
          },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "at"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "progress" },
                  "at": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fires when scene progress crosses this value." }
                }
              },
              {
                "type": "object",
                "required": ["type"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "tap" },
                  "target": { "type": "string", "description": "Actor id that must be tapped. Omitted = tap anywhere." }
                }
              },
              {
                "type": "object",
                "required": ["type", "key", "equals"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "state" },
                  "key": { "type": "string", "description": "Fires when this flag/counter becomes equal to `equals`." },
                  "equals": { "type": ["boolean", "number", "string"] }
                }
              }
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["type", "target", "clip"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "playAnimation" },
                    "target": { "type": "string", "description": "Actor id." },
                    "clip": { "type": "string", "description": "glTF animation clip name." },
                    "loop": { "type": "boolean", "description": "Loop the clip instead of playing once." }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "key", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "setState" },
                    "key": { "type": "string", "description": "Flag or counter name from state.json." },
                    "value": { "type": ["boolean", "number", "string"] }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "scene"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "gotoScene" },
                    "scene": { "type": "string", "description": "Scene id to jump to." }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "message"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "log" },
                    "message": { "type": "string", "description": "Debug action: logs to the console." }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "asset"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "playSound" },
                    "asset": { "type": "string", "description": "Audio asset id to play as a sound effect." },
                    "loop": { "type": "boolean" }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "target", "visible"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "setVisible" },
                    "target": { "type": "string", "description": "Actor id to show or hide." },
                    "visible": { "type": "boolean" }
                  }
                },
                {
                  "type": "object",
                  "required": ["type", "target", "enabled"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "const": "setEffect" },
                    "target": { "type": "string", "description": "Effect id to enable or disable." },
                    "enabled": { "type": "boolean" }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["key", "equals"],
      "additionalProperties": false,
      "description": "State condition: true when the flag/counter `key` currently equals `equals`.",
      "properties": {
        "key": { "type": "string" },
        "equals": { "type": ["boolean", "number", "string"] }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "description": "Position in meters, rotation as XYZ euler degrees, uniform or per-axis scale.",
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/vec3" },
        "scale": {
          "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "$ref": "#/$defs/vec3" }]
        }
      }
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "easing": {
      "enum": ["linear", "easeIn", "easeOut", "easeInOut", "step"],
      "description": "Interpolation from the previous keyframe to this one. Default linear."
    },
    "vec3Track": {
      "type": "array",
      "minItems": 1,
      "description": "Keyframes over scene progress t in [0,1], sorted by t.",
      "items": {
        "type": "object",
        "required": ["t", "value"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": { "$ref": "#/$defs/vec3" },
          "easing": { "$ref": "#/$defs/easing" }
        }
      }
    },
    "numberTrack": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "value"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": { "type": "number" },
          "easing": { "$ref": "#/$defs/easing" }
        }
      }
    }
  }
}
