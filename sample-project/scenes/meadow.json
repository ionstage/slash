{
  "formatVersion": 2,
  "id": "meadow",
  "name": "Dusk Meadow",
  "scrollLength": 4,
  "stage": {
    "assetId": "meadow-stage"
  },
  "audio": { "ambient": "wind" },
  "environment": {
    "fog": { "color": "#1a1a2e", "near": 10, "far": 48 }
  },
  "lights": [
    { "id": "sky", "type": "ambient", "color": [0.45, 0.45, 0.62], "intensity": 0.9 },
    {
      "id": "sun",
      "type": "directional",
      "color": [1, 0.82, 0.55],
      "intensity": 2,
      "position": [6, 10, 4],
      "tracks": {
        "intensity": [
          { "t": 0, "value": 2 },
          { "t": 1, "value": 0.7, "easing": "easeInOut" }
        ],
        "color": [
          { "t": 0, "value": [1, 0.82, 0.55] },
          { "t": 1, "value": [0.55, 0.6, 0.9], "easing": "easeInOut" }
        ]
      }
    }
  ],
  "effects": [
    {
      "id": "fireflies",
      "preset": "fireflies",
      "count": 80,
      "area": [30, 5, 44],
      "position": [0, 1.8, -8],
      "tracks": {
        "intensity": [
          { "t": 0, "value": 0.2 },
          { "t": 1, "value": 1, "easing": "easeIn" }
        ]
      }
    }
  ],
  "actors": [
    {
      "id": "traveler",
      "assetId": "traveler",
      "transform": { "position": [0, 0, 0], "rotation": [0, 180, 0] },
      "tracks": {
        "position": [
          { "t": 0, "value": [0, 0, 0] },
          { "t": 0.8, "value": [0, 0, -14], "easing": "easeInOut" },
          { "t": 1, "value": [0, 0, -16], "easing": "easeOut" }
        ]
      }
    },
    {
      "id": "old-tree",
      "assetId": "tree",
      "transform": { "position": [-3, 0, -10], "scale": 1.5 }
    }
  ],
  "camera": {
    "viewpoint": {
      "position": [0, 2.2, 6.5],
      "target": [0, 1.2, -4],
      "fov": 48
    },
    "drift": {
      "target": [
        { "t": 0, "value": [0, 0, 0] },
        { "t": 1, "value": [0, 0, -6], "easing": "easeInOut" }
      ]
    }
  },
  "events": [
    {
      "id": "notice-tree",
      "trigger": { "type": "tap", "target": "old-tree" },
      "actions": [
        { "type": "setState", "key": "noticedTree", "value": true },
        { "type": "log", "message": "The old tree seems to whisper something." }
      ]
    },
    {
      "id": "halfway",
      "trigger": { "type": "progress", "at": 0.5 },
      "actions": [{ "type": "log", "message": "The meadow darkens as dusk settles." }]
    }
  ]
}
